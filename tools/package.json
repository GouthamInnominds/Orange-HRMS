{
  "name": "orangehrm-qkg-tools",
  "version": "2.0.0",
  "description": "Quality Knowledge Graph Parser & Ingestion Engine for OrangeHRM",
  "main": "qkg_engine/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "ingest:staging": "node qkg_engine/ingest_pipeline.js --staging --clean",
    "ingest:promote": "node qkg_engine/ingest_pipeline.js --promote",
    "validate:golden": "node qkg_engine/validate_golden_dataset.js",
    "manifest": "node qkg_engine/snapshot_manifest.js",
    "compare": "node qkg_engine/snapshot_comparator.js",
    "parity": "node qkg_engine/parity_verifier.js",
    "benchmark:tia": "node qkg_engine/run_tia_benchmark.js --offline",
    "mcp": "node qkg_mcp/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "neo4j-driver": "^5.27.0",
    "php-parser": "^3.1.5"
  }
}
